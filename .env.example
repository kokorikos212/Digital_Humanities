# ── LLM API ─────────────────────────────────────────────────────────────────
# Use LLM_API_KEY for any OpenAI-compatible provider, or DEEPSEEK_KEY for legacy.
DEEPSEEK_KEY=sk-your-key-here
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com       # default: DeepSeek
# LLM_MODEL=deepseek-chat                     # default: deepseek-chat

# ── OCR / VLM Transcription ─────────────────────────────────────────────────
# Uses Hugging Face Inference API for image-to-text transcription.
# HF_TOKEN=hf_...                         # Hugging Face token (required)
# BYTEZ_VL_MODEL=Qwen/Qwen2.5-VL-72B-Instruct:featherless-ai  # VLM model